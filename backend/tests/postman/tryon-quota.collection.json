        {
          "name": "AC-17 sản phẩm chưa có ảnh -> 429 TRYON_QUOTA_EXCEEDED scope day, có thời điểm có lượt mới",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 429', () => pm.response.to.have.status(429));",
                  "{ const b = pm.response.json(); pm.test('error format TRYON_QUOTA_EXCEEDED', () => { pm.expect(b.success).to.eql(false); pm.expect(b.error.code).to.eql('TRYON_QUOTA_EXCEEDED'); pm.expect(b.error.message).to.be.a('string').and.not.empty; pm.expect(JSON.stringify(b)).to.not.match(/stack|postgres|supabase|service_role/i); }); }",
                  "const e = pm.response.json().error;",
                  "pm.test('scope day, retryAfterSeconds > 0, resetsAt ISO', () => { pm.expect(e.details.scope).to.eql('day'); pm.expect(e.details.retryAfterSeconds).to.be.above(0); pm.expect(e.details.resetsAt).to.match(/^\\d{4}-\\d{2}-\\d{2}T.*Z$/); });",
                  "pm.test('header Retry-After khớp', () => pm.expect(Number(pm.response.headers.get('Retry-After'))).to.eql(e.details.retryAfterSeconds));"
                ]
              }
            }
