        {
          "name": "AC-17 ảnh pQ2 sẵn sàng",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = pm.environment.get('jobQ');",
                  "const token = pm.environment.get('tokenA');",
                  "const deadline = Date.now() + 40000;",
                  "const poll = () => pm.sendRequest({ url: pm.environment.get('baseUrl') + '/try-on/jobs/' + id, method: 'GET', header: { Authorization: 'Bearer ' + token } }, (err, res) => {",
                  "  const st = res && res.code === 200 ? res.json().data.job.status : null;",
                  "  if ((st && st !== 'queued' && st !== 'running') || Date.now() > deadline) return;",
                  "  setTimeout(poll, 400);",
                  "});",
                  "poll();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.job.status).to.eql('succeeded');"
                ]
              }
            }
