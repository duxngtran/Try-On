        {
          "name": "AC-01 GET danh sách (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json().data.categories;",
                  "pm.test('mỗi danh mục đúng contract', () => list.forEach((c) => {",
                  "pm.expect(c.id).to.be.a('string');",
                  "pm.expect(c.name).to.be.a('string');",
                  "pm.expect(c.productCount).to.be.a('number');",
                  "pm.expect(c.createdAt).to.match(/^\\d{4}-\\d{2}-\\d{2}T[\\d:.]+Z$/);",
                  "pm.expect(c).to.not.have.property('deleted_at');",
                  "}));",
                  "pm.test('sắp theo createdAt tăng dần', () => {",
                  "for (let i = 1; i < list.length; i += 1) pm.expect(list[i].createdAt >= list[i - 1].createdAt).to.eql(true);",
                  "});",
                  "pm.test('danh mục seed còn lại giữ đúng thứ tự Áo thun, Váy, Quần Jeans', () => {",
                  "const seeds = ['Áo thun', 'Váy', 'Quần Jeans'];",
                  "const names = list.map((c) => c.name).filter((n) => seeds.includes(n));",
                  "pm.expect(names).to.eql(seeds.filter((n) => names.includes(n)));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/categories",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "categories"]
            }
          }
        },
