        {
          "name": "Setup - đăng nhập admin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tag = Date.now().toString(36) + Math.random().toString(36).slice(2, 6);",
                  "pm.environment.set('tag', tag);",
                  "pm.environment.set('nameA', 'POSTMAN-' + tag + '-A');",
                  "pm.environment.set('nameRaw', '  POSTMAN-' + tag + '-A  Áo   khoác ');",
                  "pm.environment.set('nameB', 'POSTMAN-' + tag + '-B');",
                  "pm.environment.set('name50', ('POSTMAN-' + tag + '-').padEnd(50, 'x'));",
                  "pm.environment.set('userEmail', 'pm-cat-' + tag + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json(); pm.expect(b.data.user.role).to.eql('admin');",
                  "pm.environment.set('adminToken', b.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ADMIN_EMAIL}}\",\n  \"password\": \"{{ADMIN_PASSWORD}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
