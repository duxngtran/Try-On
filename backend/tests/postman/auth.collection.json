    {
      "name": "Login - 429 TOO_MANY_ATTEMPTS after 5 wrong passwords (dedicated email)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const base = pm.environment.get('baseUrl'), email = pm.environment.get('lockEmail'), pw = pm.environment.get('password');",
              "const post = (path, body) => new Promise((res, rej) => pm.sendRequest({ url: base + '/' + path, method: 'POST', header: { 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify(body) } }, (e, r) => e ? rej(e) : res(r)));",
              "(async () => {",
              "  const reg = await post('auth/register', { email, password: pw });",
              "  pm.test('setup: lock email registered', () => pm.expect(reg.code).to.eql(201));",
              "  for (let i = 1; i <= 5; i++) {",
              "    const r = await post('auth/login', { email, password: 'WrongPass999' });",
              "    pm.test('wrong attempt ' + i + ' -> 401', () => pm.expect(r.code).to.eql(401));",
              "  }",
              "})().catch(e => { throw e; });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 429', () => pm.response.to.have.status(429));",
              "const b = pm.response.json();",
              "pm.test('error format TOO_MANY_ATTEMPTS', () => { pm.expect(b.success).to.eql(false); pm.expect(b.error.code).to.eql('TOO_MANY_ATTEMPTS'); pm.expect(b.error.message).to.be.a('string').and.not.empty; pm.expect(b).to.not.have.property('data'); });",
              "pm.test('retryAfterSeconds + Retry-After header', () => { const s = b.error.details.retryAfterSeconds; pm.expect(s).to.be.a('number').within(1, 900); pm.expect(pm.response.headers.get('Retry-After')).to.be.ok; });",
              "pm.test('message mentions minutes', () => pm.expect(b.error.message).to.match(/quá nhiều lần.*\\d+ phút/));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
