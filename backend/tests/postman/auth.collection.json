  "item": [
    {
      "name": "Register - ok (email normalized, role user)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);",
              "pm.environment.set('email', 'pm-' + id + '@example.com');",
              "pm.environment.set('email2', 'pm-' + id + '-b@example.com');",
              "pm.environment.set('lockEmail', 'pm-' + id + '-lock@example.com');",
              "pm.environment.set('password', 'Test1234x');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test('success + token', () => { pm.expect(b.success).to.eql(true); pm.expect(b.data.token).to.be.a('string').and.not.empty; });",
              "pm.test('user shape', () => { const u = b.data.user; pm.expect(u).to.have.keys('id','email','role','profileCompleted','createdAt'); pm.expect(u.role).to.eql('user'); pm.expect(u.profileCompleted).to.be.a('boolean'); pm.expect(new Date(u.createdAt).toISOString()).to.eql(u.createdAt); });",
              "pm.test('email trimmed + lowercase, profileCompleted false', () => { pm.expect(b.data.user.email).to.eql(pm.environment.get('email')); pm.expect(b.data.user.profileCompleted).to.eql(false); });",
              "pm.test('no password/hash leaked', () => { const t = pm.response.text(); pm.expect(t).to.not.match(/password_hash|passwordHash|\\$2[aby]\\$/); });",
              "pm.environment.set('userToken', b.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"  {{email}}  \",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
