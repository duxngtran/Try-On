# Sao chép thành backend/.env và điền giá trị thật. KHÔNG commit file .env.
NODE_ENV=development
PORT=4000
# Origin của frontend (CORS chỉ cho phép origin này)
CORS_ORIGIN=http://localhost:5173

# Supabase (chỉ backend; service role key tuyệt đối không đưa vào frontend)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Chỉ cho script migrate (D-19). Dùng direct/session connection, không dùng pooler cổng 6543
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Auth
JWT_SECRET=<chuoi-ngau-nhien-it-nhat-32-ky-tu>
JWT_EXPIRES_IN=7d
BCRYPT_COST=10
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_PER_MIN=20

# Ảnh hồ sơ (bucket private)
PROFILE_PHOTO_BUCKET=profile-photos
PHOTO_MAX_MB=10
PHOTO_UPLOADS_PER_HOUR=10
SIGNED_URL_TTL_SECONDS=900

# Ảnh sản phẩm (bucket public, D-46)
PRODUCT_IMAGE_BUCKET=product-images
PRODUCT_IMAGE_MAX_MB=10
PRODUCT_IMAGE_CACHE_SECONDS=604800
PRODUCT_WRITES_PER_HOUR=120

# Chỉ dùng cho seed admin (D-07)
ADMIN_EMAIL=admin@tryon.local
ADMIN_PASSWORD=<mat-khau-manh>

# ---- Phòng thử đồ (sprint 03) ----
# Công tắc tắt ngay: false thì ảnh đã có vẫn xem được, không tạo job mới
TRYON_ENABLED=true
# Tắt riêng generate trước
TRYON_PREFETCH_ENABLED=true
# fake | fashn. GIỮ fake cho tới khi user cho phép gọi dịch vụ thật (D-91). Với fashn: bắt buộc FASHN_API_KEY,
# và không được dùng khi NODE_ENV=test
TRYON_PROVIDER=fake
# Chỉ adapter giả
TRYON_FAKE_DELAY_MS=1500
# Bucket private cho ảnh try-on (D-78)
TRYON_IMAGE_BUCKET=tryon-images
TRYON_IMAGE_MAX_MB=5
# Giới hạn mỗi người (D-94, giờ Việt Nam) và ngân sách toàn hệ thống
TRYON_DAILY_LIMIT=20
TRYON_MONTHLY_LIMIT=100
TRYON_MONTHLY_BUDGET_USD=50
TRYON_BUDGET_WARN_PERCENT=80
# Giá công bố, chưa đo (D-91)
TRYON_COST_PER_IMAGE_USD=0.075
TRYON_PREFETCH_MIN_REMAINING=3
TRYON_MAX_RUNNING_PER_USER=2
TRYON_MAX_ACTIVE_PER_USER=4
TRYON_SYSTEM_CONCURRENCY=6
TRYON_JOB_DEADLINE_SECONDS=120
TRYON_MAX_ATTEMPTS=2
TRYON_RETRY_DELAY_SECONDS=2
TRYON_POLL_SECONDS=2
TRYON_SUBMIT_LEASE_SECONDS=30
TRYON_QUEUE_STALE_SECONDS=8
TRYON_WORKER_TICK_MS=1000
TRYON_PROVIDER_PAUSE_SECONDS=300
TRYON_CLEANUP_TICK_SECONDS=30
TRYON_DELETE_RETRY_SECONDS=60
TRYON_IMAGE_RETENTION_DAYS=90
TRYON_JOB_RETENTION_DAYS=35
TRYON_JOB_CREATES_PER_MIN=30
TRYON_READS_PER_MIN=240
# FASHN: chỉ điền khi user cho phép dùng dịch vụ thật. KHÔNG commit
FASHN_API_KEY=
FASHN_BASE_URL=https://api.fashn.ai/v1
FASHN_MODEL_NAME=tryon-v1.6
FASHN_MODE=balanced
FASHN_MODERATION_LEVEL=permissive
FASHN_OUTPUT_FORMAT=jpeg
FASHN_MODEL_IMAGE_MAX_SIDE=1536
FASHN_REQUEST_TIMEOUT_MS=15000
