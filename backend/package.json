{
  "name": "tryon-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postman": "node tests/postman/run.js",
    "lint": "eslint .",
    "seed:admin": "node --env-file-if-exists=.env scripts/seed-admin.js",
    "setup:storage": "node --env-file-if-exists=.env scripts/setup-storage.js",
    "verify:products": "node --env-file-if-exists=.env scripts/verify-products-live.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "fixtures": "node scripts/generate-fixtures.js",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "verify:tryon": "node --env-file-if-exists=.env scripts/verify-tryon-live.js",
    "tryon:purge-model": "node --env-file-if-exists=.env scripts/tryon-purge-model.js",
    "tryon:report": "node --env-file-if-exists=.env scripts/tryon-report.js",
    "tryon:pilot": "node --env-file-if-exists=.env scripts/tryon-pilot.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  }
}
